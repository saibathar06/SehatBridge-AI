ENVIRONMENT=development
DATABASE_URL=sqlite:///./sehatbridge.db
# For PostgreSQL: postgresql+psycopg://sehatbridge:CHANGE_ME@localhost:5432/sehatbridge
REDIS_URL=
JWT_SECRET=GENERATE_ME
OTP_SECRET=GENERATE_ME
ENCRYPTION_KEY=GENERATE_ME
ACCESS_MINUTES=15
REFRESH_DAYS=30
OTP_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
GEMINI_API_KEY=
# Select a currently available multimodal model in your Google AI project.
GEMINI_MODEL=
AI_TIMEOUT_SECONDS=60
AI_MAX_OUTPUT_TOKENS=8192
EXTRACTION_BATCH_PAGES=5
STORAGE_PATH=./storage
MAX_UPLOAD_MB=20
MAX_PAGES=40
FIREBASE_CREDENTIALS=
CORS_ORIGINS=[]
DEMO_ENABLED=true
RATE_LIMIT_PER_MINUTE=90
LOG_LEVEL=warning
# Google web reCAPTCHA v2 checkbox (not v3 or the native SafetyNet Android key).
# Disabled only for local development until you configure your own key pair.
RECAPTCHA_ENABLED=false
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
# Public origin hosting this backend's checkbox page. No path or trailing / needed.
RECAPTCHA_PUBLIC_ORIGIN=http://localhost:8000
RECAPTCHA_ALLOWED_HOSTNAMES=["localhost"]
